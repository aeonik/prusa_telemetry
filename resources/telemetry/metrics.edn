{:schema/version 1
 :catalog/id :prusa-buddy-metrics
 :catalog/source {:firmware-repo "Prusa-Firmware-Buddy"
                  :firmware-revision "77255c9c8"
                  :scanned-at "2026-06-16"
                  :notes ["Scanned METRIC_DEF entries from firmware src and lib/Marlin."
                          "Metric availability is firmware-build dependent; :condition records the feature guard when visible."
                          "Metric names preserve firmware spelling exactly. Display code can add friendlier aliases later."
                          "probe_z_diff is registered in firmware but no recording call was found in the scanned tree."]}
 :protocol {:transport :udp-syslog
            :syslog-app-name "buddy"
            :message-prefix-fields ["msg" "tm" "v"]
            :line-format :influx-line-protocol-subset
            :timestamp {:field :trailing-offset
                        :unit :microsecond
                        :description "Per-point timestamp is emitted as a microsecond offset from the syslog message header timestamp."}
            :scalar-fields {:float {:field "v" :value-type :float}
                            :integer {:field "v" :value-type :integer}
                            :string {:field "v" :value-type :string}
                            :event {:field "v" :value-type :event :literal "T"}}
            :custom {:description "METRIC_VALUE_CUSTOM appends firmware-provided tags and fields directly after the metric name."
                     :parser :line-protocol}
            :error-field {:field "error"
                          :value-type :string
                          :description "Any metric can emit an error field if the formatted point does not fit the firmware point buffer."}
            :gcodes [{:code "M331" :args ["metric"] :description "Enable one metric by firmware metric name."}
                     {:code "M332" :args ["metric"] :description "Disable one metric by firmware metric name."}
                     {:code "M333" :description "List all firmware metrics and enabled states."}
                     {:code "M334" :args ["ip address" "metrics port" "log port"] :description "Configure and enable metrics. No arguments disables metrics."}]}
 :screens {:settings {:title "METRICS & LOG"
                      :source ["src/gui/screen_menu_metrics.hpp"
                               "src/gui/screen_menu_metrics.cpp"
                               "src/gui/screen_menu_network.hpp"
                               "src/gui/MItem_menus.hpp"]
                      :items [{:id :enable-metrics :config "enable_metrics"}
                              {:id :host :config "metrics_host"}
                              {:id :metrics-port :config "metrics_port"}
                              {:id :syslog-port :config "syslog_port"}
                              {:id :metrics-list :screen "ScreenMenuMetricsList"}]
                      :tooltip "Network menu screen used to configure where Buddy metrics and logs are sent."}
           :list {:title "METRICS LIST"
                  :source ["src/gui/screen_menu_metrics_list.hpp"
                           "src/gui/screen_menu_metrics_list.cpp"
                           "src/common/metric.cpp"]
                  :behavior "Iterates metric_get_iterator_begin/end over linker-section metric definitions and toggles metric.enabled."
                  :tooltip "Runtime list of all compiled metrics in the firmware image."}}
 :groups {:system "Firmware runtime, CPU, heap, and metric transport health."
          :identity "Firmware, board, material, and print identity."
          :print-state "Print-state and G-code execution progress."
          :motion "Planner, position, homing, stall, and prefetch behavior."
          :thermal "Temperatures, targets, heater PWM, chamber, and thermal protection."
          :power "Voltage, current, and overcurrent telemetry."
          :fan "Fan state, fan RPM, and fan control telemetry."
          :loadcell "Loadcell samples, filtering, tare, and probing analysis."
          :filament "Filament sensor, MMU, and material-handling telemetry."
          :toolchanger "XL dwarf, modular bed, and tool offset calibration telemetry."
          :input-shaper "Accelerometer and input-shaper calibration telemetry."
          :touch "Touchscreen diagnostics."
          :debug "Firmware debug and diagnostic metrics."}
 :parsers {:scalar/float {:kind :scalar :field "v" :value-type :float}
           :scalar/integer {:kind :scalar :field "v" :value-type :integer}
           :scalar/string {:kind :scalar :field "v" :value-type :string}
           :scalar/event {:kind :scalar :field "v" :value-type :event :literal "T"}
           :custom/extruder-value {:kind :line-protocol
                                   :tags [{:name "n" :value-type :integer :label "extruder"}
                                          {:name "a" :value-type :integer :label "active"}]
                                   :fields [{:name "value" :value-type :float}]}
           :custom/index-value {:kind :line-protocol
                                :tags [{:name "n" :value-type :integer :label "index"}]
                                :fields [{:name "v" :value-type :float}]}
           :custom/xyz-fields {:kind :line-protocol
                               :fields [{:name "x" :value-type :float}
                                        {:name "y" :value-type :float}
                                        {:name "z" :value-type :float}]}}
 :metrics
 [{:name "app_start" :firmware-symbol "metric_app_start" :type :event :default-enabled? true :interval-ms 0 :group :system :source "src/common/appmain.cpp:91" :parser :scalar/event :tooltip "Emitted once when the Buddy application setup begins."}
  {:name "maintask_loop" :firmware-symbol "metric_maintask_event" :type :event :default-enabled? false :interval-ms 0 :group :system :source "src/common/appmain.cpp:92" :parser :scalar/event :tooltip "Emitted every main application loop; useful as a high-rate loop heartbeat when explicitly enabled."}
  {:name "cpu_usage" :firmware-symbol "metric_cpu_usage" :type :integer :default-enabled? true :interval-ms 1000 :group :system :source "src/common/appmain.cpp:93" :parser :scalar/integer :unit :percent :tooltip "Operating-system CPU usage sample recorded from the main loop."}
  {:name "fw_version" :firmware-symbol "fw_version" :type :string :default-enabled? true :interval-ms 65535 :group :identity :source "src/common/app_metrics.cpp:62" :parser :scalar/string :tooltip "Full firmware version string."}
  {:name "buddy_revision" :firmware-symbol "buddy_revision" :type :string :default-enabled? true :interval-ms 65534 :group :identity :source "src/common/app_metrics.cpp:65" :parser :scalar/string :tooltip "Buddy board revision read from OTP; emitted as a string."}
  {:name "buddy_bom" :firmware-symbol "buddy_bom" :type :string :default-enabled? true :interval-ms 65533 :group :identity :source "src/common/app_metrics.cpp:70" :parser :scalar/string :tooltip "Buddy board BOM identifier read from OTP; emitted as a string."}
  {:name "filament" :firmware-symbol "metric_current_filament" :type :string :default-enabled? true :interval-ms 10070 :group :identity :source "src/common/app_metrics.cpp:75" :parser :scalar/string :tooltip "Configured filament type name for the active extruder."}
  {:name "stack" :firmware-symbol "stack" :type :custom :default-enabled? true :interval-ms 0 :group :system :source "src/common/app_metrics.cpp:79" :parse {:kind :line-protocol :tags [{:name "n" :value-type :string :label "task"}] :fields [{:name "t" :value-type :integer :unit :byte :label "stack allocation"} {:name "m" :value-type :integer :label "high-water mark"}]} :tooltip "Per-FreeRTOS-task stack allocation and remaining high-water mark sampled about every 3 seconds."}
  {:name "runtime" :firmware-symbol "runtime" :type :custom :default-enabled? true :interval-ms 0 :group :system :source "src/common/app_metrics.cpp:80" :condition "configGENERATE_RUN_TIME_STATS" :parse {:kind :line-protocol :tags [{:name "n" :value-type :string :label "task"}] :fields [{:name "u" :value-type :integer :unit :percent}]} :tooltip "Per-task CPU runtime share over the last runtime-stat interval."}
  {:name "heap" :firmware-symbol "heap" :type :custom :default-enabled? true :interval-ms 503 :group :system :source "src/common/app_metrics.cpp:135" :parse {:kind :line-protocol :fields [{:name "free" :value-type :integer :unit :byte} {:name "total" :value-type :integer :unit :byte}]} :tooltip "FreeRTOS heap free and total bytes."}
  {:name "is_printing" :firmware-symbol "is_printing" :type :integer :default-enabled? true :interval-ms 5000 :group :print-state :source "src/common/app_metrics.cpp:140" :parser :scalar/integer :tooltip "Boolean-like flag, 1 when printing is active and 0 otherwise."}
  {:name "active_extruder" :firmware-symbol "active_extruder_metric" :type :integer :default-enabled? true :interval-ms 1000 :group :toolchanger :source "src/common/app_metrics.cpp:144" :condition "PRUSA_TOOLCHANGER" :parser :scalar/integer :tooltip "Active tool/extruder index on toolchanger builds."}
  {:name "temp_hbr" :firmware-symbol "heatbreak" :type :custom :default-enabled? false :interval-ms 0 :group :thermal :source "src/common/app_metrics.cpp:149" :condition "HAS_TEMP_HEATBREAK" :parser :custom/extruder-value :unit :celsius :tooltip "Heatbreak temperature for each available extruder; tag a marks the active extruder."}
  {:name "temp_brd" :firmware-symbol "board" :type :float :default-enabled? false :interval-ms 991 :group :thermal :source "src/common/app_metrics.cpp:160" :condition "HAS_TEMP_BOARD" :parser :scalar/float :unit :celsius :tooltip "Buddy board temperature reported by Marlin thermal manager."}
