#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
SESSION="${PRUSA_TELEMETRY_TMUX_SESSION:-prusa-telemetry-dev}"

NREPL_BIND="${NREPL_BIND:-127.0.0.1}"
NREPL_PORT="${NREPL_PORT:-7888}"
SHADOW_NREPL_PORT="${SHADOW_NREPL_PORT:-9631}"
TELEMETRY_PORT="${TELEMETRY_PORT:-8514}"
WEB_PORT="${WEB_PORT:-8080}"
SHADOW_HTTP_PORT="${SHADOW_HTTP_PORT:-9632}"
CLJ_EXTRA_ALIASES="${CLJ_EXTRA_ALIASES:-}"
BACKEND_ALIASES="${BACKEND_ALIASES:-:dev${CLJ_EXTRA_ALIASES}:dev-service}"
SHADOW_ALIASES="${SHADOW_ALIASES:-:shadow-cljs${CLJ_EXTRA_ALIASES}}"
SERVICE_CONFIG_FILE="$ROOT/log/dev-service.env"
FLOW_STORM_DEBUGGER="${FLOW_STORM_DEBUGGER:-false}"
FLOW_STORM_CLJS_PREFIXES="${FLOW_STORM_CLJS_PREFIXES:-aeonik.prusalink,aeonik.ws}"
SHADOW_FORCE_SPAWN="${SHADOW_FORCE_SPAWN:-false}"
SHADOW_CONFIG_MERGE="{}"

if [[ "$SHADOW_ALIASES" == *":clojurestorm"* ]]; then
  SHADOW_CONFIG_MERGE="{:devtools {:preloads [shadow.cljs.devtools.client.browser flow-storm-shim.preload]}}"
  SHADOW_FORCE_SPAWN=true
fi

ensure_frontend_deps() {
  if [[ -d "$ROOT/node_modules/react" && -d "$ROOT/node_modules/react-dom" ]]; then
    return 0
  fi

  if command -v npm >/dev/null 2>&1; then
    echo "Installing frontend JavaScript dependencies with npm ci --ignore-scripts"
    (cd "$ROOT" && npm ci --ignore-scripts)
    return 0
  fi

  cat >&2 <<EOF
Missing frontend JavaScript dependencies.

Install Node/npm and rerun:
  bin/dev-service start

The application is Clojure/ClojureScript, but Reagent 2 uses React from npm
while compiling and running the development frontend.
EOF
  exit 1
}

has_session() {
  tmux has-session -t "$SESSION" 2>/dev/null
}

print_endpoints() {
  cat <<EOF
backend nREPL: ${NREPL_BIND}:${NREPL_PORT}
shadow nREPL:  127.0.0.1:${SHADOW_NREPL_PORT}
app:           http://localhost:${SHADOW_HTTP_PORT}
backend HTTP:  http://localhost:${WEB_PORT}
telemetry UDP: ${TELEMETRY_PORT}
EOF

  if [[ -f "$SERVICE_CONFIG_FILE" ]]; then
    cat "$SERVICE_CONFIG_FILE"
  else
    cat <<EOF
backend aliases: ${BACKEND_ALIASES}
shadow aliases:  ${SHADOW_ALIASES}
EOF
  fi
}

write_service_config() {
  cat > "$SERVICE_CONFIG_FILE" <<EOF
backend aliases: ${BACKEND_ALIASES}
shadow aliases:  ${SHADOW_ALIASES}
shadow config:   ${SHADOW_CONFIG_MERGE}
shadow fresh:    ${SHADOW_FORCE_SPAWN}
flowstorm gui:   ${FLOW_STORM_DEBUGGER}
cljs storm ns:   ${FLOW_STORM_CLJS_PREFIXES}
EOF
}

start_storm_debugger() {
  if [[ "$FLOW_STORM_DEBUGGER" != "true" ]]; then
    return 0
  fi

  tmux new-window -t "${SESSION}:" -c "$ROOT" -n storm \
    "clojure -M:clojurestorm -e '(require (quote flow-storm.debugger.main)) (flow-storm.debugger.main/start-debugger {:local? false :repl-type :shadow}) @(promise)' 2>&1 | tee -a log/dev-storm.log"
}

start_service() {
  if has_session; then
    echo "Already running in tmux session: ${SESSION}"
    print_endpoints
    return 0
  fi

  mkdir -p "$ROOT/log"
  ensure_frontend_deps
  write_service_config

  tmux new-session -d -s "$SESSION" -c "$ROOT" -n backend \
    "env PRUSA_TELEMETRY_AUTO_START=false FLOW_STORM_REMOTE_CONNECT='${FLOW_STORM_DEBUGGER}' NREPL_BIND='${NREPL_BIND}' NREPL_PORT='${NREPL_PORT}' TELEMETRY_PORT='${TELEMETRY_PORT}' WEB_PORT='${WEB_PORT}' clojure -M${BACKEND_ALIASES} 2>&1 | tee -a log/dev-backend.log"

  local shadow_spawn_arg=""
  if [[ "$SHADOW_FORCE_SPAWN" == "true" ]]; then
    shadow_spawn_arg="--force-spawn"
  fi
  local shadow_env=""
  if [[ "$SHADOW_ALIASES" == *":clojurestorm"* ]]; then
    shadow_env="env JAVA_TOOL_OPTIONS='${JAVA_TOOL_OPTIONS:-} -Dcljs.storm.instrumentAutoPrefixes=false -Dcljs.storm.instrumentOnlyPrefixes=${FLOW_STORM_CLJS_PREFIXES}'"
  fi

  tmux new-window -t "${SESSION}:" -c "$ROOT" -n shadow \
    "${shadow_env} clojure -M${SHADOW_ALIASES} ${shadow_spawn_arg} --config-merge '${SHADOW_CONFIG_MERGE}' watch app 2>&1 | tee -a log/dev-shadow.log"

  start_storm_debugger

  echo "Started tmux session: ${SESSION}"
  print_endpoints
}

stop_service() {
  if ! has_session; then
    echo "Not running: ${SESSION}"
    return 0
  fi

  tmux send-keys -t "${SESSION}:backend" C-c 2>/dev/null || true
  tmux send-keys -t "${SESSION}:shadow" C-c 2>/dev/null || true
  tmux send-keys -t "${SESSION}:storm" C-c 2>/dev/null || true

  for _ in $(seq 1 20); do
    if ! has_session; then
      echo "Stopped tmux session: ${SESSION}"
      return 0
    fi
    sleep 0.25
  done

  tmux kill-session -t "$SESSION" 2>/dev/null || true
  rm -f "$SERVICE_CONFIG_FILE"
  echo "Stopped tmux session: ${SESSION}"
}

status_service() {
  if has_session; then
    echo "running: ${SESSION}"
    tmux list-windows -t "$SESSION" -F '  #I:#W #{pane_current_command}'
    print_endpoints
  else
    echo "stopped: ${SESSION}"
  fi
}

attach_service() {
  if ! has_session; then
    echo "Not running: ${SESSION}"
    exit 1
  fi
  exec tmux attach-session -t "$SESSION"
}

tail_logs() {
  mkdir -p "$ROOT/log"
  touch "$ROOT/log/dev-backend.log" "$ROOT/log/dev-shadow.log"
  exec tail -n 80 -f "$ROOT/log/dev-backend.log" "$ROOT/log/dev-shadow.log"
}

connect_backend_repl() {
  exec clojure -M:nrepl-client -m nrepl.cmdline --connect --host "$NREPL_BIND" --port "$NREPL_PORT"
}

connect_shadow_repl() {
  exec clojure -M:nrepl-client -m nrepl.cmdline --connect --host 127.0.0.1 --port "$SHADOW_NREPL_PORT"
}

usage() {
  cat <<EOF
Usage: bin/dev-service <command>

Commands:
  start        Start backend service, backend nREPL, shadow watch, and shadow nREPL
  stop         Stop the tmux-managed dev service
  restart      Stop and start the dev service
  debug        Restart with ClojureStorm, CLJS preload, and FlowStorm GUI
  status       Show service status and endpoints
  attach       Attach to the tmux session
  logs         Tail backend and shadow logs
  repl         Connect to the backend Clojure nREPL
  cljs-repl    Connect to the shadow-cljs nREPL

Environment:
  NREPL_PORT=${NREPL_PORT}
  SHADOW_NREPL_PORT=${SHADOW_NREPL_PORT}
  TELEMETRY_PORT=${TELEMETRY_PORT}
  WEB_PORT=${WEB_PORT}
  SHADOW_HTTP_PORT=${SHADOW_HTTP_PORT}
  CLJ_EXTRA_ALIASES=${CLJ_EXTRA_ALIASES}    # appended to backend and shadow aliases
  FLOW_STORM_DEBUGGER=${FLOW_STORM_DEBUGGER}
  FLOW_STORM_CLJS_PREFIXES=${FLOW_STORM_CLJS_PREFIXES}
  BACKEND_ALIASES=${BACKEND_ALIASES}
  SHADOW_ALIASES=${SHADOW_ALIASES}
EOF
}

command="${1:-status}"
case "$command" in
  start) start_service ;;
  stop) stop_service ;;
  restart) stop_service; start_service ;;
  debug) stop_service; CLJ_EXTRA_ALIASES="${CLJ_EXTRA_ALIASES:-:clojurestorm}" FLOW_STORM_DEBUGGER=true BACKEND_ALIASES="" SHADOW_ALIASES="" exec "$0" start ;;
  status) status_service ;;
  attach) attach_service ;;
  logs) tail_logs ;;
  repl) connect_backend_repl ;;
  cljs-repl) connect_shadow_repl ;;
  help|-h|--help) usage ;;
  *) usage; exit 2 ;;
esac
