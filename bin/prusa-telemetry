#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ -n "${PRUSA_TELEMETRY_JAR:-}" ]]; then
  JAR="$PRUSA_TELEMETRY_JAR"
else
  SEARCH_ROOTS=("$ROOT")
  if [[ -d "$ROOT/target" ]]; then
    SEARCH_ROOTS+=("$ROOT/target")
  fi
  JAR="$(find "${SEARCH_ROOTS[@]}" -maxdepth 1 -type f -name 'prusa_telemetry-*.jar' 2>/dev/null | sort -V | tail -n 1)"
fi

if [[ -z "${JAR:-}" || ! -f "$JAR" ]]; then
  cat >&2 <<EOF
No prusa_telemetry jar found.

Build one with:
  clojure -T:build release

Or set:
  PRUSA_TELEMETRY_JAR=/path/to/prusa_telemetry-VERSION.jar
EOF
  exit 1
fi

exec java ${JAVA_OPTS:-} -jar "$JAR" "$@"
